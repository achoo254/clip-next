# /etc/systemd/system/clip-media-cleanup.service — deletes videos older than 7 days, and leftovers of uploads and
# renders (the server and worker remove those themselves; this catches a crash). Run by clip-media-cleanup.timer.
[Unit]
Description=Delete expired Clip videos and stale temporary files

[Service]
Type=oneshot
User=clip
Group=clip
ExecStart=/usr/bin/find /var/www/clip/media/videos -type f -name *.mp4 -mmin +10080 -delete
ExecStart=/usr/bin/find /var/www/clip/media/inputs -mindepth 1 -maxdepth 1 -mmin +1440 -exec rm -rf {} +
ExecStart=/usr/bin/find /var/www/clip/media/tmp -mindepth 1 -maxdepth 1 -mmin +720 -exec rm -rf {} +
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/www/clip/media
