# /etc/systemd/system/clip-media-cleanup.service — retention, run hourly by clip-media-cleanup.timer:
# - jobs (the person's text) at their expiry date, 7 days after they were made, with their video and photos;
# - expired or unused sessions; video files no job owns;
# - leftovers of uploads and renders the server and worker normally remove themselves (a crash).
[Unit]
Description=Delete expired Clip jobs, videos and sessions
After=postgresql.service

[Service]
Type=oneshot
User=clip
Group=clip
EnvironmentFile=/etc/clip/production.env
WorkingDirectory=/var/www/clip/app
ExecStart=/opt/node22/bin/node --enable-source-maps apps/worker/dist/cleanup.mjs
ExecStart=/usr/bin/find /var/www/clip/media/inputs -mindepth 1 -maxdepth 1 -mmin +1440 -exec rm -rf {} +
ExecStart=/usr/bin/find /var/www/clip/media/tmp -mindepth 1 -maxdepth 1 -mmin +720 -exec rm -rf {} +
IPAddressDeny=any
IPAddressAllow=localhost
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/www/clip/media
