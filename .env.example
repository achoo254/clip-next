# Clip server and worker env. Copy to .env for a local run only if you need sign-in; nothing here is required in
# dev (PGlite under .data/, media under .data/media, sign-in off). Production values live in the iCloud env folder
# "ENV production/clip-next/" and on the server in /etc/clip/production.env — never in the repo.

# development | test | production
NODE_ENV=development
# Server port on 127.0.0.1 (dev 5292; production 4840 behind nginx).
PORT=5292
# Where people open the app; the sign-in callback is PUBLIC_URL/auth/callback (dev: the Vite server).
PUBLIC_URL=http://localhost:5293
# The account service (OIDC issuer) and the confidential web client registered there.
AUTH_ISSUER=https://auth.hoandat.com
AUTH_CLIENT_ID=clip-web
# Secret of clip-web (auth-next's CLIP_WEB_CLIENT_SECRET), 32+ characters. Empty: sign-in is off.
AUTH_CLIENT_SECRET=
# Postgres, database `clip`. Empty: embedded PGlite under .data/pglite and the render worker runs in the server.
DATABASE_URL=
# Uploads, renders and finished videos (production: /var/www/clip/media). Empty in dev: .data/media.
MEDIA_DIR=
# Chrome for the renders (production: /usr/bin/google-chrome). Empty: hyperframes finds or downloads one.
CHROME_PATH=
# An ffmpeg/ffprobe with libx264 for the renders (worker only). With it hyperframes writes MP4 itself, about five
# times faster than the WebM path the server's distribution ffmpeg (no libx264) forces. Empty: the ones on PATH.
FFMPEG_PATH=
FFPROBE_PATH=
